include README.md
include LICENSE
include CITATION.cff
include AUTHORS.md
include dependency_matrix.md
include requirements.txt
include pyproject.toml
include setup.py
graft cmake
graft ye3t/core/csrc
graft ye3t/representations/csrc
graft ye3t/runtime/csrc
graft examples
graft docs
graft tests
global-exclude *.py[cod]
global-exclude __pycache__/*
global-exclude .DS_Store
global-exclude *.csv
global-exclude *.gif
global-exclude *.jpg
global-exclude *.jpeg
global-exclude *.log
global-exclude *.npy
global-exclude *.npz
global-exclude *.pdf
global-exclude *.png
global-exclude *.pt
global-exclude *.pth
global-exclude *.svg
prune examples/generated
prune docs/_build
prune generated
