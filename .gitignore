build/
dist/
*.egg-info/
pip-wheel-metadata/
*.so
*.pyd
*.dylib

# Local environments
.venv/
venv/
env/

# Temporary files
.pytest-tmp*/
*.tmp
*.temp
*.log
.tmp/
.tmp-*/
.runtime/
piptmp/
pytest-cache-files-*/
pytest_tmp*/
tmp/
temp/
generated/
examples/generated/

# Editor and OS metadata
.DS_Store
Thumbs.db
*.swp
*.swo
